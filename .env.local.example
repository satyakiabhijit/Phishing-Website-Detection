# ═══════════════════════════════════════════════════════════
# PhishGuard — Environment Variables
# Copy this file to .env.local and fill in your keys
# ═══════════════════════════════════════════════════════════

# Threat Intelligence APIs
VT_API_KEY=           # VirusTotal API key (free tier: 4 req/min)
GSB_API_KEY=          # Google Safe Browsing v4 API key
IPQS_API_KEY=         # IPQualityScore API key

# Hugging Face Space URL (your deployed model)
HF_SPACE_URL=         # e.g. https://yourusername-phishguard-ml-engine.hf.space

# Vercel KV (Redis) — auto-populated when linked in Vercel dashboard
KV_REST_API_URL=      # Vercel KV REST API URL
KV_REST_API_TOKEN=    # Vercel KV REST API token
